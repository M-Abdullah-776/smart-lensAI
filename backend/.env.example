# Database
DATABASE_URL=sqlite:///./smartlens.db

# Security & JWT
SECRET_KEY=smartlens_production_super_secret_jwt_key_2026_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_INACTIVITY_MINUTES=30

# AI Provider Configuration (gemini, openai, or anthropic)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smartlens.ai
EMAIL_VERIFICATION=false
FRONTEND_URL=http://localhost:5173

# Default System Administrator Account
ADMIN_EMAIL=admin@smartlens.ai
ADMIN_PASSWORD=Admin@12345

# Application Limits & CORS
MAX_UPLOAD_SIZE_MB=10
DAILY_AI_REQUEST_LIMIT=50
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
