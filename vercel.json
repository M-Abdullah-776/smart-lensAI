{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://smart-lensai.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://smart-lensai.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://smart-lensai.onrender.com/admin/:path*"
    },
    {
      "source": "/((?!auth|api|admin).*)",
      "destination": "/index.html"
    }
  ]
}
